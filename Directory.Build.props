<Project>

  <!-- Product related property configurations -->
  <PropertyGroup>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <Authors>Service Well AB</Authors>
    <Company>Service Well AB</Company>
    <Copyright>Copyright © Service Well AB. All rights reserved.</Copyright>
    <Deterministic>true</Deterministic>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Product>Service Well Health</Product>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepoRootPath>$(MSBuildThisFileDirectory)</RepoRootPath>
    <LatestFramework>net8.0</LatestFramework>  
  </PropertyGroup>

  <PropertyGroup>
    <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)\CustomAnalysisRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)\stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRootPath)NOTICE" Pack="true" PackagePath="" Visible="false" Condition="Exists('$(RepoRootPath)NOTICE')" />
  </ItemGroup>

</Project>